        "present_in_repo": false
      },
      "sizing": {
        "fp32_mb": 90,
        "int8_mb": 25
      },
      "task": {
        "pipeline": "feature-extraction",
        "input": "agent text, tool descriptions, finding evidence snippets",
        "output": "384-dimensional semantic embedding"
